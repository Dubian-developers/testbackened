# Optional: comma-separated frontend origins allowed to call the API (default: any)
ALLOWED_ORIGINS=

# ---- M-Pesa (Daraja) ----
MPESA_ENV=sandbox                 # or production
PUBLIC_URL=https://your-app.up.railway.app   # public https URL Safaricom can reach
MPESA_CALLBACK_SECRET=long-random-string     # becomes part of the callback URLs
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379            # paybill/till for STK Push
MPESA_PASSKEY=
MPESA_TXN_TYPE=CustomerPayBillOnline          # CustomerBuyGoodsOnline for tills
# B2C payouts
MPESA_B2C_SHORTCODE=              # defaults to MPESA_SHORTCODE
MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=
MPESA_CERT_PATH=./cert.cer        # Safaricom public cert; or set MPESA_SECURITY_CREDENTIAL directly
MPESA_SECURITY_CREDENTIAL=
